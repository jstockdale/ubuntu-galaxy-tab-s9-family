[Unit]
Description=Tab Companion docked S Pen pairing
After=bluetooth.service
Wants=bluetooth.service
# The daemon's D-Bus proxies bind to one bluetoothd instance; when bluez is
# restarted (every bluez package update does this from its postinst), the old
# proxies answer ServiceUnknown forever and the S Pen BLE features silently
# die while the unit still reports active. Restart alongside bluetoothd
# instead of trying to outlive it.
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/libexec/tab-companion-spen-pairing
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
