[Unit]
Description=Tab Companion hardware service for UID %i
# A system service so that it, and nothing else in the session, can hold the
# input group: it grabs the cover keyboard, reads the pen and creates the
# uinput devices.  It still runs as the user, on the user's session bus, and
# is pulled in by user@.service.d/50-tab-companion-hardware.conf.
After=user@%i.service
BindsTo=user@%i.service

[Service]
Type=simple
# Ordinary login accounts only: not gdm's greeter or gnome-initial-setup.
ExecCondition=/bin/sh -c 'test %i -ge 1000 && test %i -lt 60000'
User=%i
SupplementaryGroups=input
Environment=XDG_RUNTIME_DIR=/run/user/%i
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%i/bus
# -I: ignore ~/.local site-packages and PYTHON* variables.  The user can
# write those, and anything they import would run with the input group.
ExecStart=/usr/bin/python3 -I /usr/libexec/tab-companion-hardware
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
