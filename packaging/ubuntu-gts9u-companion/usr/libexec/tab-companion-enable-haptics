#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Enable the bundled extensions without overwriting the user's extension list.

Keyboard haptics, and the multi-finger taps that Tab Companion's Touch page
sets.  Each does nothing until its own setting asks for it."""

from gi.repository import Gio


UUIDS = ("tab-companion-haptics@agcarbajo", "tab-companion-touch@agcarbajo")
settings = Gio.Settings.new("org.gnome.shell")
enabled = list(settings.get_strv("enabled-extensions"))
missing = [uuid for uuid in UUIDS if uuid not in enabled]
if missing:
    if not settings.set_strv("enabled-extensions", enabled + missing):
        raise SystemExit("could not enable the Tab Companion extensions")
