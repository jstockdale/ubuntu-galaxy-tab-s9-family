+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ */
+
+#include "soft_af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <map>
+
+namespace libcamera {
+
+namespace ipa::soft {
+
+namespace {
+
+constexpr int32_t kReferenceRange = 1023;
+
+int32_t scaleCodes(int32_t codes, int32_t range)
+{
+	return static_cast<int32_t>((static_cast<int64_t>(codes) * range +
+				     kReferenceRange / 2) / kReferenceRange);
+}
+
+} /* namespace */
+
+/*
+ * The defaults are tuned for a 10-bit lens control (0-1023, the DW9808):
+ * scale every position and speed to another range.
+ */
+SoftAf::Tuning SoftAf::tuningForRange(int32_t minPosition, int32_t maxPosition)
+{
+	Tuning t;
+	int32_t range = maxPosition - minPosition;
+	if (range <= 0)
+		return t;
+
+	t.minPosition = minPosition;
+	t.maxPosition = maxPosition;
+	t.scanLow = minPosition + scaleCodes(t.scanLow, range);
+	t.scanHigh = minPosition + scaleCodes(t.scanHigh, range);
+	t.moveStep = std::max(1, scaleCodes(t.moveStep, range));
+	t.coarseStep = std::max(1, scaleCodes(t.coarseStep, range));
+	t.localStep = std::max(1, scaleCodes(t.localStep, range));
+	t.fineStep = std::max(1, scaleCodes(t.fineStep, range));
+	t.fineHalfWidth = std::max(2 * t.fineStep, scaleCodes(t.fineHalfWidth, range));
+	t.localRange = std::max(2 * t.localStep, scaleCodes(t.localRange, range));
+	return t;
+}
+
+SoftAf::SoftAf()
+	: SoftAf(Tuning())
+{
+}
+
+SoftAf::SoftAf(const Tuning &tuning)
+	: tuning_(tuning),
+	  position_((tuning.minPosition + tuning.maxPosition + 1) / 2),
+	  target_(position_), speed_(tuning.moveStep), basePosition_(position_)
+{
+}
+
+int32_t SoftAf::clampPosition(int32_t position) const
+{
+	return std::clamp(position, tuning_.minPosition, tuning_.maxPosition);
+}
+
+void SoftAf::setPosition(int32_t position)
+{
+	position_ = clampPosition(position);
+	target_ = position_;
+	basePosition_ = position_;
+	history_.clear();
+}
+
+void SoftAf::reset()
+{
+	/* Frame numbers restart with the stream; the lens stays where it is. */
+	history_.clear();
+	basePosition_ = position_;
+	target_ = position_;
+	moved_ = false;
+	samples_.clear();
+	result_.reset();
+
+	if (mode_ == Mode::Continuous)
+		waitStable(true);
+	else
+		stop();
+}
+
+void SoftAf::stop()
+{
+	phase_ = Phase::Idle;
+	state_ = State::Idle;
+	target_ = position_;
+}
+
+void SoftAf::setMode(Mode mode)
+{
+	if (mode == mode_)
+		return;
+
+	mode_ = mode;
+	if (mode_ == Mode::Continuous)
+		waitStable(true);
+	else
+		stop();
+}
+
+void SoftAf::trigger()
+{
+	if (mode_ == Mode::Manual)
+		return;
+
+	startFullScan();
+}
+
+void SoftAf::cancel()
+{
+	if (mode_ == Mode::Auto)
+		stop();
+}
+
+std::optional<SoftAf::Result> SoftAf::takeResult()
+{
+	std::optional<Result> result = result_;
+	result_.reset();
+	return result;
+}
+
+void SoftAf::waitStable(bool startup)
+{
+	phase_ = Phase::WaitStable;
+	startup_ = startup;
+	recent_.clear();
+	waitSamples_ = 0;
+	target_ = position_;
+	if (startup)
+		state_ = State::Scanning;
+}
+
+void SoftAf::startFullScan()
+{
+	search_ = Search::Full;
+	state_ = State::Scanning;
+	searchStartFrame_ = lastFrame_;
+	searchStartPosition_ = position_;
+
+	/* Start from the nearer end: the least travel. */
+	bool up = position_ - tuning_.scanLow <= tuning_.scanHigh - position_;
+	sweepFrom_ = up ? tuning_.scanLow : tuning_.scanHigh;
+	sweepTo_ = up ? tuning_.scanHigh : tuning_.scanLow;
+	sweepStep_ = tuning_.coarseStep;
+	sweepMayReverse_ = false;
+	approach(sweepFrom_);
+}
+
+void SoftAf::startLocalScan()
+{
+	search_ = Search::Local;
+	state_ = State::Scanning;
+	searchStartFrame_ = lastFrame_;
+	searchStartPosition_ = position_;
+
+	int32_t low = std::max(tuning_.scanLow, position_ - tuning_.localRange);
+	int32_t high = std::min(tuning_.scanHigh, position_ + tuning_.localRange);
+	int32_t start = std::clamp(position_, low, high);
+
+	int direction = lastDirection_;
+	if (start >= high)
+		direction = -1;
+	else if (start <= low)
+		direction = 1;
+
+	sweepFrom_ = start;
+	sweepTo_ = direction > 0 ? high : low;
+	sweepOther_ = direction > 0 ? low : high;
+	sweepStep_ = tuning_.localStep;
+	sweepMayReverse_ = sweepOther_ != start;
+	approach(sweepFrom_);
+}
+
+void SoftAf::startFine(int32_t peak)
+{
+	search_ = Search::Fine;
+
+	int32_t low = clampPosition(peak - tuning_.fineHalfWidth);
+	int32_t high = clampPosition(peak + tuning_.fineHalfWidth);
+	fineLow_ = low;
+	fineHigh_ = high;
+
+	/* Enter the window from the side the lens is on. */
+	bool up = std::abs(position_ - low) <= std::abs(position_ - high);
+	sweepFrom_ = up ? low : high;
+	sweepTo_ = up ? high : low;
+	sweepStep_ = tuning_.fineStep;
+	sweepMayReverse_ = false;
+	fineReturn_ = true;
+	approach(sweepFrom_);
+}
+
+void SoftAf::approach(int32_t position)
+{
+	phase_ = Phase::Approach;
+	target_ = clampPosition(position);
+	speed_ = tuning_.moveStep;
+}
+
+void SoftAf::beginSweep()
+{
+	phase_ = Phase::Sweep;
+	samples_.clear();
+
+	/*
+	 * A sweep first measures where it starts: a local search to tell
+	 * whether its first steps lead away from focus, a fine pass to hold
+	 * still at its turn, where a wrong latency would credit samples to
+	 * the wrong side.  Only the full scan's sweep moves on at once.
+	 */
+	sweepMoving_ = search_ == Search::Full;
+	if (sweepMoving_) {
+		target_ = sweepTo_;
+		speed_ = sweepStep_;
+	}
+}
+
+void SoftAf::reverseSweep()
+{
+	/*
+	 * Contrast fell on the way out: go back to the start and search the
+	 * other side instead.
+	 */
+	sweepMayReverse_ = false;
+	std::swap(sweepTo_, sweepOther_);
+	lastDirection_ = -lastDirection_;
+	approach(sweepFrom_);
+}
+
+void SoftAf::finishSweep()
+{
+	auto best = std::max_element(samples_.begin(), samples_.end(),
+				     [](const Sample &a, const Sample &b) {
+					     return a.score < b.score;
+				     });
+	bool contrast = best != samples_.end() &&
+			static_cast<double>(best->score) >=
+				static_cast<double>(median()) * (1.0 + tuning_.minContrast);
+
+	switch (search_) {
+	case Search::Full:
+		if (contrast && samples_.size() >= 3) {
+			fineRetries_ = 0;
+			fineSamples_.clear();
+			startFine(coarsePeak());
+			return;
+		}
+		/* A flat scene has no focus to find: stay on the best. */
+		settleAt(best != samples_.end() ? best->position : position_, false);
+		return;
+
+	case Search::Local:
+		if (contrast && samples_.size() >= 3) {
+			fineRetries_ = 0;
+			fineSamples_.clear();
+			startFine(coarsePeak());
+			return;
+		}
+		/*
+		 * Nothing sharper nearby: the new scene's focus is further
+		 * away, or it has none.  Search everywhere, once per change.
+		 */
+		if (!fullAfterLocal_) {
+			fullAfterLocal_ = true;
+			startFullScan();
+			return;
+		}
+		settleAt(best != samples_.end() ? best->position : position_, found_);
+		return;
+
+	case Search::Fine: {
+		fineSamples_.insert(fineSamples_.end(), samples_.begin(), samples_.end());
+
+		/* Back across the window, from where the lens is. */
+		if (fineReturn_) {
+			fineReturn_ = false;
+			std::swap(sweepFrom_, sweepTo_);
+			approach(sweepFrom_);
+			return;
+		}
+
+		if (fineSamples_.empty()) {
+			settleAt(position_, true);
+			return;
+		}
+		/*
+		 * Fit the whole window, with every pass's samples in it.  A
+		 * vertex beyond an edge means the peak lies outside: move the
+		 * window towards it.  Without a vertex (a flat or noisy window)
+		 * keep the best measurement.
+		 */
+		int32_t low = fineLow_ - tuning_.fineStep;
+		int32_t high = fineHigh_ + tuning_.fineStep;
+		std::optional<double> vertex = fitVertex(low, high);
+
+		int32_t measured = position_;
+		double measuredScore = -1;
+		for (const Sample &sample : fineSamples_) {
+			if (sample.position >= low && sample.position <= high &&
+			    static_cast<double>(sample.score) > measuredScore) {
+				measuredScore = static_cast<double>(sample.score);
+				measured = sample.position;
+			}
+		}
+
+		bool outside = vertex &&
+			       ((*vertex < fineLow_ && fineLow_ > tuning_.minPosition) ||
+				(*vertex > fineHigh_ && fineHigh_ < tuning_.maxPosition));
+		if (outside && fineRetries_ < tuning_.fineRetries) {
+			/* Half a window towards it: the windows overlap. */
+			fineRetries_++;
+			int32_t centre = (fineLow_ + fineHigh_) / 2;
+			int32_t half = tuning_.fineHalfWidth;
+			int32_t next = static_cast<int32_t>(std::lround(std::clamp(
+				*vertex, static_cast<double>(centre - half),
+				static_cast<double>(centre + half))));
+			startFine(next);
+			return;
+		}
+
+		int32_t peak = vertex ? static_cast<int32_t>(std::lround(
+						std::clamp(*vertex, static_cast<double>(low),
+							   static_cast<double>(high))))
+				      : measured;
+		settleAt(peak, true);
+		return;
+	}
+	}
+}
+
+void SoftAf::settleAt(int32_t position, bool found)
+{
+	found_ = found;
+	phase_ = Phase::Settle;
+	target_ = clampPosition(position);
+	speed_ = tuning_.moveStep;
+	referenceSum_ = 0;
+	referenceSquares_ = 0;
+	referenceSamples_ = 0;
+
+	if (target_ != searchStartPosition_)
+		lastDirection_ = target_ > searchStartPosition_ ? 1 : -1;
+}
+
+bool SoftAf::settledFor(uint32_t frame) const
+{
+	return !moved_ || frame - lastMoveFrame_ >= tuning_.latencyFrames;
+}
+
+int32_t SoftAf::positionAt(uint32_t frame) const
+{
+	if (frame < tuning_.latencyFrames)
+		return basePosition_;
+
+	uint32_t commanded = frame - tuning_.latencyFrames;
+	int32_t position = basePosition_;
+	for (const auto &[f, p] : history_) {
+		if (f > commanded)
+			break;
+		position = p;
+	}
+	return position;
+}
+
+/*
+ * The coarse samples are too far apart to centre the fine pass on the best
+ * one: put it at the vertex of the parabola through the best and its
+ * neighbours, which is within a sample spacing of it.
+ */
+int32_t SoftAf::coarsePeak() const
+{
+	std::map<int32_t, std::pair<double, unsigned int>> merged;
+	for (const Sample &s : samples_) {
+		auto &[sum, count] = merged[s.position];
+		sum += static_cast<double>(s.score);
+		count++;
+	}
+
+	std::vector<std::pair<double, double>> points;
+	for (const auto &[position, value] : merged)
+		points.emplace_back(position, value.first / value.second);
+	if (points.empty())
+		return position_;
+
+	size_t best = 0;
+	for (size_t i = 1; i < points.size(); ++i) {
+		if (points[i].second > points[best].second)
+			best = i;
+	}
+	if (best == 0 || best + 1 >= points.size())
+		return static_cast<int32_t>(points[best].first);
+
+	const auto [x0, y0] = points[best - 1];
+	const auto [x1, y1] = points[best];
+	const auto [x2, y2] = points[best + 1];
+	double num = (x1 - x0) * (x1 - x0) * (y1 - y2) -
+		     (x1 - x2) * (x1 - x2) * (y1 - y0);
+	double den = (x1 - x0) * (y1 - y2) - (x1 - x2) * (y1 - y0);
+	if (std::abs(den) < 1e-9)
+		return static_cast<int32_t>(x1);
+
+	double x = std::clamp(x1 - 0.5 * num / den, (x0 + x1) / 2, (x1 + x2) / 2);
+	return static_cast<int32_t>(std::lround(x));
+}
+
+uint64_t SoftAf::median() const
+{
+	std::vector<uint64_t> scores;
+	scores.reserve(samples_.size());
+	for (const Sample &s : samples_)
+		scores.push_back(s.score);
+	if (scores.empty())
+		return 0;
+
+	auto middle = scores.begin() + scores.size() / 2;
+	std::nth_element(scores.begin(), middle, scores.end());
+	return *middle;
+}
+
+bool SoftAf::peakPassed() const
+{
+	/* A fine pass measures its whole window, for the fit. */
+	if (search_ == Search::Fine || samples_.size() < 3)
+		return false;
+
+	size_t best = 0;
+	for (size_t i = 1; i < samples_.size(); ++i) {
+		if (samples_[i].score > samples_[best].score)
+			best = i;
+	}
+
+	/* Only a clear peak ends a sweep early, never a noise spike. */
+	double peak = static_cast<double>(samples_[best].score);
+	if (peak < static_cast<double>(median()) * (1.0 + tuning_.earlyContrast))
+		return false;
+
+	size_t after = samples_.size() - 1 - best;
+	double last = static_cast<double>(samples_.back().score);
+	if (after >= 1 && last < peak * (1.0 - 2.0 * tuning_.peakDrop))
+		return true;
+	if (after >= 2 &&
+	    last < peak * (1.0 - tuning_.peakDrop) &&
+	    static_cast<double>(samples_[samples_.size() - 2].score) <
+		    peak * (1.0 - tuning_.peakDrop))
+		return true;
+	return false;
+}
+
+/*
+ * Near the peak a sample differs from its neighbours by less than the noise,
+ * so fit a parabola by least squares to every fine sample in [low, high],
+ * from all fine passes, rather than through three.  Returns its vertex,
+ * unclamped, or nothing if the samples are too few or not a peak.
+ */
+std::optional<double> SoftAf::fitVertex(int32_t low, int32_t high) const
+{
+	/* Average repeated positions, ordered by position. */
+	std::map<int32_t, std::pair<double, unsigned int>> merged;
+	for (const Sample &s : fineSamples_) {
+		if (s.position < low || s.position > high)
+			continue;
+		auto &[sum, count] = merged[s.position];
+		sum += static_cast<double>(s.score);
+		count++;
+	}
+	if (merged.size() < 3)
+		return std::nullopt;
+
+	/* Centre x for conditioning: y = a x^2 + b x + c. */
+	double x0 = (low + high) / 2.0;
+	double s0 = 0, s1 = 0, s2 = 0, s3 = 0, s4 = 0, t0 = 0, t1 = 0, t2 = 0;
+	for (const auto &[position, value] : merged) {
+		double x = position - x0;
+		double x2 = x * x;
+		double y = value.first / value.second;
+		s0 += 1;
+		s1 += x;
+		s2 += x2;
+		s3 += x2 * x;
+		s4 += x2 * x2;
+		t0 += y;
+		t1 += y * x;
+		t2 += y * x2;
+	}
+
+	/* Normal equations, by Cramer's rule. */
+	double det = s4 * (s2 * s0 - s1 * s1) - s3 * (s3 * s0 - s1 * s2) +
+		     s2 * (s3 * s1 - s2 * s2);
+	if (std::abs(det) < 1e-12)
+		return std::nullopt;
+
+	double a = (t2 * (s2 * s0 - s1 * s1) - s3 * (t1 * s0 - s1 * t0) +
+		    s2 * (t1 * s1 - s2 * t0)) / det;
+	double b = (s4 * (t1 * s0 - s1 * t0) - t2 * (s3 * s0 - s1 * s2) +
+		    s2 * (s3 * t0 - t1 * s2)) / det;
+	if (a >= 0)
+		return std::nullopt;
+
+	return x0 - b / (2 * a);
+}
+
+double SoftAf::changeRatio() const
+{
+	/*
+	 * A mean of changeSamples samples against the slowly tracked
+	 * reference: its deviation is about noise / sqrt(changeSamples),
+	 * the reference's adds a tenth.
+	 */
+	double deviation = noise_ * 1.1 / std::sqrt(static_cast<double>(tuning_.changeSamples));
+	return std::max(tuning_.changeRatio, tuning_.noiseMargin * deviation);
+}
+
+double SoftAf::stableRatio() const
+{
+	/* Successive samples differ by noise * sqrt(2). */
+	return std::max(tuning_.stableRatio, tuning_.noiseMargin * noise_ * std::sqrt(2.0));
+}
+
+void SoftAf::onSample(uint32_t frame, uint64_t score)
+{
+	switch (phase_) {
+	case Phase::Idle:
+	case Phase::Approach:
+		return;
+
+	case Phase::WaitStable: {
+		/* Only a still lens tells whether the scene is still. */
+		if (!settledFor(frame))
+			return;
+
+		recent_.push_back(score);
+		while (recent_.size() > tuning_.stableSamples)
+			recent_.pop_front();
+		waitSamples_++;
+
+		double mean = 0;
+		for (uint64_t s : recent_)
+			mean += static_cast<double>(s);
+		mean /= static_cast<double>(recent_.size());
+
+		/* Still: every sample close to the one before it. */
+		bool still = recent_.size() >= tuning_.stableSamples;
+		for (size_t i = 1; i < recent_.size(); ++i) {
+			double previous = static_cast<double>(recent_[i - 1]);
+			double current = static_cast<double>(recent_[i]);
+			if (std::abs(current - previous) > previous * stableRatio())
+				still = false;
+		}
+
+		unsigned int timeout = startup_ ? tuning_.startupTimeout
+						: tuning_.stableTimeout;
+		if (!still && waitSamples_ < timeout)
+			return;
+
+		if (startup_) {
+			fullAfterLocal_ = false;
+			failedRetries_ = 0;
+			startFullScan();
+			return;
+		}
+
+		/* The scene came back as it was: nothing to refocus. */
+		if (reference_ && recent_.size() >= tuning_.changeSamples &&
+		    std::abs(mean - static_cast<double>(reference_)) <=
+			    static_cast<double>(reference_) * changeRatio()) {
+			phase_ = Phase::Locked;
+			lockedRecent_.clear();
+			return;
+		}
+
+		fullAfterLocal_ = false;
+		startLocalScan();
+		return;
+	}
+
+	case Phase::Sweep: {
+		if (!sweepMoving_) {
+			/* Measure the start before leaving it. */
+			if (!settledFor(frame))
+				return;
+			samples_.push_back({ position_, score });
+			if (position_ == sweepTo_) {
+				finishSweep();
+				return;
+			}
+			sweepMoving_ = true;
+			target_ = sweepTo_;
+			speed_ = sweepStep_;
+			return;
+		}
+
+		samples_.push_back({ positionAt(frame), score });
+
+		/* Heading out of focus: the first two steps were both worse. */
+		if (sweepMayReverse_ && samples_.size() == 3 &&
+		    samples_[1].score < samples_[0].score &&
+		    static_cast<double>(samples_[2].score) <
+			    static_cast<double>(samples_[0].score) *
+				    (1.0 - tuning_.peakDrop / 2.0)) {
+			reverseSweep();
+			return;
+		}
+
+		if (peakPassed() ||
+		    (position_ == sweepTo_ && settledFor(frame)))
+			finishSweep();
+		return;
+	}
+
+	case Phase::Settle: {
+		if (position_ != target_)
+			return;
+
+		/* On the peak: report it now, measure the reference meanwhile. */
+		if (state_ == State::Scanning) {
+			state_ = found_ ? State::Focused : State::Failed;
+			result_ = Result{ position_, found_, frame - searchStartFrame_ };
+		}
+		if (!settledFor(frame))
+			return;
+
+		referenceSum_ += score;
+		referenceSquares_ += static_cast<double>(score) * static_cast<double>(score);
+		if (++referenceSamples_ < tuning_.changeSamples)
+			return;
+
+		reference_ = referenceSum_ / referenceSamples_;
+
+		/* The still lens's samples also tell how noisy this scene is. */
+		double n = static_cast<double>(referenceSamples_);
+		double mean = static_cast<double>(referenceSum_) / n;
+		double variance = (referenceSquares_ - n * mean * mean) / (n - 1);
+		if (mean > 0)
+			noise_ = std::clamp(std::sqrt(std::max(variance, 0.0)) / mean, 0.01, 0.25);
+		phase_ = Phase::Locked;
+		lockedRecent_.clear();
+		lockedSamples_ = 0;
+		lastLockedScore_ = 0;
+		if (found_)
+			failedRetries_ = 0;
+		return;
+	}
+
+	case Phase::Locked: {
+		if (mode_ != Mode::Continuous || !settledFor(frame))
+			return;
+
+		if (!reference_) {
+			reference_ = score;
+			return;
+		}
+
+		/*
+		 * Nothing to focus on: a subject that appears far out of focus
+		 * can look as flat as the blank scene did.  Search again a few
+		 * times, less and less often, then only on a change.
+		 */
+		lockedSamples_++;
+		if (state_ == State::Failed && failedRetries_ < tuning_.failedRetries) {
+			unsigned int wait = tuning_.failedRetrySamples;
+			for (unsigned int i = 0; i < failedRetries_; ++i)
+				wait *= 3;
+			if (lockedSamples_ >= wait) {
+				failedRetries_++;
+				fullAfterLocal_ = true;
+				startFullScan();
+				return;
+			}
+		}
+
+		/*
+		 * Learn the noise from a still lens: the mean absolute difference
+		 * of two samples is 2 / sqrt(pi) times their deviation.
+		 */
+		if (lastLockedScore_) {
+			double diff = std::abs(static_cast<double>(score) -
+					       static_cast<double>(lastLockedScore_)) /
+				      static_cast<double>(lastLockedScore_);
+			double sample = std::min(diff * std::sqrt(M_PI) / 2.0, 0.25);
+			noise_ = 0.9 * noise_ + 0.1 * sample;
+		}
+		lastLockedScore_ = score;
+
+		lockedRecent_.push_back(score);
+		while (lockedRecent_.size() > tuning_.changeSamples)
+			lockedRecent_.pop_front();
+		if (lockedRecent_.size() < tuning_.changeSamples)
+			return;
+
+		double mean = 0;
+		for (uint64_t s : lockedRecent_)
+			mean += static_cast<double>(s);
+		mean /= static_cast<double>(lockedRecent_.size());
+
+		double ratio = mean / static_cast<double>(reference_);
+		if (std::abs(ratio - 1.0) > changeRatio()) {
+			/* A new scene: it gets its own retries. */
+			failedRetries_ = 0;
+			waitStable(false);
+			return;
+		}
+
+		/* Still the same scene: follow its slow drift (light, noise). */
+		double track = static_cast<double>(tuning_.referenceTrack);
+		reference_ = static_cast<uint64_t>(std::llround(
+			static_cast<double>(reference_) +
+			(static_cast<double>(score) - static_cast<double>(reference_)) / track));
+		return;
+	}
+	}
+}
+
+std::optional<int32_t> SoftAf::process(uint32_t frame, std::optional<uint64_t> score)
+{
+	lastFrame_ = frame;
+
+	if (score)
+		onSample(frame, *score);
+
+	if (phase_ == Phase::Approach && position_ == target_)
+		beginSweep();
+
+	int32_t previous = position_;
+	if (position_ != target_) {
+		position_ += std::clamp(target_ - position_, -speed_, speed_);
+		lastMoveFrame_ = frame;
+		moved_ = true;
+	}
+
+	history_.emplace_back(frame, position_);
+	while (history_.size() > kHistoryFrames)
+		history_.pop_front();
+
+	if (position_ != previous)
+		return position_;
+	return std::nullopt;
+}
