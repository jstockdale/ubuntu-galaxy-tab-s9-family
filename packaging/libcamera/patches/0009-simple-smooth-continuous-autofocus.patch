+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ *
+ * The lens only ever moves a few codes per frame, so a voice coil motor
+ * glides instead of jumping: it neither clicks nor rings while the image is
+ * measured.  Contrast is sampled while the lens moves; each sample is
+ * credited to the position the lens held when that frame was exposed, a
+ * fixed number of frames after the command.  Once focused the lens stays
+ * still until the contrast changes for good, there is no periodic probing.
+ *
+ * Plain C++ without libcamera dependencies, so the state machine can be
+ * exercised against a simulated lens and scene off the target.
+ */
+
+#pragma once
+
+#include <deque>
+#include <optional>
+#include <stdint.h>
+#include <utility>
+#include <vector>
+
+namespace libcamera {
+
+namespace ipa::soft {
+
+class SoftAf
+{
+public:
+	enum class Mode {
+		Manual,
+		Auto,
+		Continuous,
+	};
+
+	enum class State {
+		Idle,
+		Scanning,
+		Focused,
+		Failed,
+	};
+
+	struct Tuning {
+		/* Range of the lens control, and the part of it worth searching. */
+		int32_t minPosition = 0;
+		int32_t maxPosition = 1023;
+		int32_t scanLow = 96;
+		int32_t scanHigh = 960;
+		/* Frames from a lens command to the first frame exposed with it. */
+		unsigned int latencyFrames = 3;
+		/* Lens speeds, in codes per frame. */
+		int32_t moveStep = 24;
+		int32_t coarseStep = 20;
+		int32_t localStep = 8;
+		int32_t fineStep = 6;
+		/* The fine pass covers the coarse peak +- this, there and back:
+		 * the two directions' latency errors cancel in the fit. */
+		int32_t fineHalfWidth = 48;
+		/* A fine pass whose peak lies outside moves on, half a window
+		 * at a time, at most this often. */
+		unsigned int fineRetries = 2;
+		/* A refocus first searches the lens position +- this. */
+		int32_t localRange = 224;
+		/* A sweep has passed the peak once contrast fell this far below it. */
+		double peakDrop = 0.12;
+		/* ... and may stop early if the peak beats its median by this. */
+		double earlyContrast = 0.35;
+		/* A sweep found a peak if it beat its median by this much. */
+		double minContrast = 0.15;
+		/* Focused, a scene changed when the mean of this many samples
+		 * moved this far from the focused contrast (also measured over
+		 * this many samples). */
+		double changeRatio = 0.10;
+		unsigned int changeSamples = 4;
+		/* A scene is still when this many samples in a row each differ
+		 * from the previous one by less than this ratio. */
+		double stableRatio = 0.08;
+		unsigned int stableSamples = 5;
+		/* Both ratios grow with the measured noise: at least this many
+		 * standard deviations of what they compare. */
+		double noiseMargin = 3.0;
+		/* Focused, the reference follows a still scene this slowly. */
+		unsigned int referenceTrack = 16;
+		/* Failed (nothing to focus on), search again after this many
+		 * samples, three times longer each time, this often; then wait
+		 * for the scene to change. */
+		unsigned int failedRetrySamples = 15;
+		unsigned int failedRetries = 3;
+		/* Samples to wait for a still scene before searching anyway. */
+		unsigned int startupTimeout = 2;
+		unsigned int stableTimeout = 24;
+	};
+
+	struct Result {
+		int32_t position = 0;
+		bool found = false;
+		uint32_t frames = 0;
+	};
+
+	/* The defaults, scaled to a lens control of another range. */
+	static Tuning tuningForRange(int32_t minPosition, int32_t maxPosition);
+
+	SoftAf();
+	explicit SoftAf(const Tuning &tuning);
+
+	/* Where the lens actually is, before the first frame. */
+	void setPosition(int32_t position);
+	/* The camera was (re)configured; statistics restart. */
+	void reset();
+	void setMode(Mode mode);
+	/* AfTriggerStart and AfTriggerCancel. */
+	void trigger();
+	void cancel();
+
+	/*
+	 * Call once per frame, in frame order, with the contrast score of the
+	 * frames that carry statistics.  Returns the lens position to command
+	 * when it changes.
+	 */
+	std::optional<int32_t> process(uint32_t frame, std::optional<uint64_t> score);
+
+	Mode mode() const { return mode_; }
+	State state() const { return state_; }
+	int32_t position() const { return position_; }
+	/* The last completed search, and whether it is new since last asked. */
+	std::optional<Result> takeResult();
+
+private:
+	enum class Phase {
+		Idle,
+		WaitStable,
+		Approach,
+		Sweep,
+		Settle,
+		Locked,
+	};
+
+	enum class Search {
+		Full,
+		Local,
+		Fine,
+	};
+
+	struct Sample {
+		int32_t position;
+		uint64_t score;
+	};
+
+	static constexpr size_t kHistoryFrames = 64;
+
+	int32_t clampPosition(int32_t position) const;
+	void stop();
+	void waitStable(bool startup);
+	void startFullScan();
+	void startLocalScan();
+	void startFine(int32_t peak);
+	void approach(int32_t position);
+	void beginSweep();
+	void reverseSweep();
+	void finishSweep();
+	void settleAt(int32_t position, bool found);
+	void onSample(uint32_t frame, uint64_t score);
+	int32_t positionAt(uint32_t frame) const;
+	bool settledFor(uint32_t frame) const;
+	bool peakPassed() const;
+	std::optional<double> fitVertex(int32_t low, int32_t high) const;
+	int32_t coarsePeak() const;
+	uint64_t median() const;
+	double changeRatio() const;
+	double stableRatio() const;
+
+	Tuning tuning_;
+	Mode mode_ = Mode::Continuous;
+	State state_ = State::Idle;
+	Phase phase_ = Phase::Idle;
+	Search search_ = Search::Full;
+
+	/* The lens: commanded position, where it is heading, how fast. */
+	int32_t position_;
+	int32_t target_;
+	int32_t speed_;
+	/* Position before the first command since reset(). */
+	int32_t basePosition_;
+	bool moved_ = false;
+	uint32_t lastMoveFrame_ = 0;
+	uint32_t lastFrame_ = 0;
+	/* (frame, commanded position after that frame), oldest first. */
+	std::deque<std::pair<uint32_t, int32_t>> history_;
+
+	/* The sweep in progress, and the search it belongs to. */
+	int32_t sweepFrom_ = 0;
+	int32_t sweepTo_ = 0;
+	int32_t sweepOther_ = 0;
+	int32_t sweepStep_ = 0;
+	bool sweepMayReverse_ = false;
+	bool sweepMoving_ = false;
+	std::vector<Sample> samples_;
+	/* Every fine pass of this search, for the fit. */
+	std::vector<Sample> fineSamples_;
+	uint32_t searchStartFrame_ = 0;
+	int32_t searchStartPosition_ = 0;
+	int lastDirection_ = 1;
+	bool fullAfterLocal_ = false;
+	unsigned int fineRetries_ = 0;
+	bool fineReturn_ = false;
+	int32_t fineLow_ = 0;
+	int32_t fineHigh_ = 0;
+
+	/* Focused, and waiting for a still scene. */
+	bool found_ = false;
+	uint64_t reference_ = 0;
+	uint64_t referenceSum_ = 0;
+	double referenceSquares_ = 0;
+	unsigned int referenceSamples_ = 0;
+	std::deque<uint64_t> lockedRecent_;
+	unsigned int lockedSamples_ = 0;
+	unsigned int failedRetries_ = 0;
+	/* Relative noise of one sample, measured while focused. */
+	double noise_ = 0.03;
+	uint64_t lastLockedScore_ = 0;
+	bool startup_ = false;
+	unsigned int waitSamples_ = 0;
+	std::deque<uint64_t> recent_;
+
+	std::optional<Result> result_;
+};
+
+} /* namespace ipa::soft */
+
+} /* namespace libcamera */
