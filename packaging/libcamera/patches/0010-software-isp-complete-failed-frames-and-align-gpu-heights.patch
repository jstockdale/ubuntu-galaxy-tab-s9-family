+	 * 1400x1050, 640x482 and 1920x1082 failed on every frame while 484,
+	 * 900 and 1080 worked.  Step heights by 4, so validate() adjusts such
+	 * a request instead of a stream that never delivers.
+	 */
+	unsigned int vStep = std::max(patternSize.height, 4u);
+
+	return SizeRange(Size(patternSize.width, vStep),
