diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index e5fa0070b..fb89e6258 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -1007,8 +1007,21 @@ void SimpleCameraData::tryCompleteRequest(Request *request)
 		return;
 	}
 
-	if (info->metadataRequired && !info->metadataProcessed)
-		return;
+	if (info->metadataRequired && !info->metadataProcessed) {
+		/*
+		 * A frame that failed or was cancelled gets no statistics, so
+		 * its metadata never comes: complete the request without it.
+		 * Waiting would leave it queued, and stop() asserts on that,
+		 * aborting the process that hosts the camera.
+		 */
+		bool failed = false;
+		for (const auto &[stream, buffer] : request->buffers()) {
+			if (buffer->metadata().status != FrameMetadata::FrameSuccess)
+				failed = true;
+		}
+		if (!failed)
+			return;
+	}
 
 	frameInfo_.destroy(info->frame);
 	pipe()->completeRequest(request);
