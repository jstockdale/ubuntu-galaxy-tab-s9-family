#!/bin/sh
# systemd-sleep hook: $1 is pre or post.
#
# In USB host role the SM-X910's dwc3/xHCI does not survive system sleep
# (kernel 7.2, 2026-11-08):
# - with nothing below the root hubs, the xHCI refuses to suspend
#   (xhci_suspend() -EINVAL: its root hubs are not suspended), so every
#   suspend aborts;
# - with a device attached (a Beats Studio Pro on a Belkin USB-C hub) the
#   tablet sleeps, but the xHC resumes dead ("Host System Error"), every
#   device is gone, and a fresh xHCI then fails to start ("Host halt
#   failed, -110") until the port is physically replugged.
# Leaving host role before the sleep works in both cases, as unplugging
# does: the controller is removed, the tablet sleeps, and after resume the
# port goes back to host and the devices enumerate again.  Attached devices
# are therefore disconnected for the sleep -- a mounted USB drive too, which
# the dead xHC would have done anyway -- until the kernel is fixed.
#
# GTS9U_SYSFS and GTS9U_RUN exist for the tests.
sys=${GTS9U_SYSFS:-/sys}
run=${GTS9U_RUN:-/run/ubuntu-gts9u}
stamp=$run/usb-role-before-sleep

role=
for r in "$sys"/class/usb_role/*/role; do
	[ -f "$r" ] && { role=$r; break; }
done
[ -n "$role" ] || exit 0

case $1 in
pre)
	[ "$(cat "$role")" = host ] || exit 0
	mkdir -p "$run"
	echo host > "$stamp"
	echo device > "$role"
	# The controller goes away as it does on unplug; give it 3 s.
	i=0
	while [ $i -lt 30 ] && [ -n "$(ls -d "$sys"/bus/usb/devices/usb* 2>/dev/null)" ]; do
		sleep 0.1
		i=$((i + 1))
	done
	;;
post)
	[ -f "$stamp" ] || exit 0
	rm -f "$stamp"
	# Back to host if the USB-C partner is attached or the port still holds
	# the host data role: after a deep sleep the partner can be missing
	# while the port, still DFP, has not re-detected it (blastoise,
	# 2026-11-08).  Only a port that has really gone back to UFP is left to
	# USB-C to set.
	if [ -d "$sys/class/typec" ] &&
		[ -z "$(ls -d "$sys"/class/typec/port*-partner 2>/dev/null)" ] &&
		! grep -qs '\[host\]' "$sys"/class/typec/port*/data_role; then
		exit 0
	fi
	echo host > "$role"
	;;
esac
exit 0
