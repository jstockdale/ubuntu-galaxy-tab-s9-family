#!/bin/sh
# Log, for every system sleep, whether the SoC reached its low-power states.
# The AOP counts AOSS sleep (aosd), CX collapse (cxsd) and DDR low power (ddr)
# in its message RAM, and qcom_stats exposes those counters in debugfs, which
# only root can open.  Sleep hooks run as root on both sides of the sleep, so
# take the two snapshots here and leave one journal line per resume that the
# adm group can read without sudo:
#   journalctl -t ubuntu-gts9u-sleep-stats
# Nothing happens on a kernel without qcom_stats.
stats=/sys/kernel/debug/qcom_stats
saved=/run/ubuntu-gts9u/sleep-stats.pre
[ -d "$stats" ] || exit 0

snapshot() {
	date +%s
	for name in aosd cxsd ddr apss adsp cdsp; do
		[ -r "$stats/$name" ] || continue
		awk -v name="$name" '
			/^Count:/ { count = $2 }
			/^Accumulated Duration:/ { ticks = $3 }
			END { if (count != "") print name, count, ticks }
		' "$stats/$name"
	done
}

case "${1-}" in
pre)
	mkdir -p "${saved%/*}"
	snapshot > "$saved" 2>/dev/null
	;;
post)
	[ -s "$saved" ] || exit 0
	# Durations are ticks of the 19.2 MHz architected timer.
	snapshot 2>/dev/null | awk '
		NR == FNR { if (FNR == 1) t0 = $1; else { c[$1] = $2; d[$1] = $3 }; next }
		FNR == 1 { line = sprintf("%s, %d s:", op, $1 - t0); next }
		($1 in c) {
			line = line sprintf(" %s +%d (%.1f s)", $1, $2 - c[$1],
				($3 - d[$1]) / 19200000)
		}
		END { print line }
	' op="${2:-sleep}" "$saved" - | logger -t ubuntu-gts9u-sleep-stats
	rm -f "$saved"
	;;
esac
exit 0
