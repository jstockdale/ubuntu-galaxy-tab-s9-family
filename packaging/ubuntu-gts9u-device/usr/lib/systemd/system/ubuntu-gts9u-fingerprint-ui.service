[Unit]
Description=Galaxy Tab fingerprint target availability broker
After=dbus.service systemd-logind.service
# Ultra only.  The EL721 path (QTEE, the K250A secure element, Goodix FOD)
# exists on the SM-X910 alone; the overlay extension that feeds this lease
# stays inactive on other boards, and fprintd is masked there.
ConditionFirmware=device-tree-compatible(samsung,gts9uwifi)

[Service]
Type=dbus
BusName=io.github.agcarbajo.Gts9uFingerprintUI
ExecStart=/usr/libexec/ubuntu-gts9u-fingerprint-ui
RuntimeDirectory=gts9u-fingerprint-ui
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
