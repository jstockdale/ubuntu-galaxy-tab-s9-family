#!/bin/sh
# SPDX-License-Identifier: MIT
# One switch for every path that can put this tablet to sleep.
#
# A short press of the power key, closing the cover, GNOME's idle timeout, the
# Suspend entry in the menus and on the login screen and a keyboard's sleep key
# all end up as a suspend request to logind, which hands it to systemd-sleep.
# Whether this board may sleep, and how, is therefore decided there and only
# there; everything else follows logind's answer.  This writes that decision
# for the board it runs on, on every boot, before logind starts:
#
#   off     Nothing suspends.  AllowSuspend=no makes logind refuse every
#           suspend request and answer CanSuspend with "no", which also takes
#           Suspend out of GNOME's menus.  systemd-sleep refuses as well, so
#           even starting suspend.target directly cannot sleep, but that
#           transaction first stops the units that conflict with
#           suspend.target (the sensor daemon): ask logind, never the target.
#           Closing the cover locks the session instead.  GNOME's idle timeout
#           defaults to doing nothing (a value the owner set still wins), and
#           ubuntu-gts9u-powerkey locks and turns the panel off.
#   s2idle  Every suspend is suspend-to-idle (SuspendState=freeze).
#   deep    The stock policy: "mem" first, which these kernels carry out as
#           PSCI SYSTEM_SUSPEND because /sys/power/mem_sleep defaults to deep.
#           Nothing is written for it.
#
# The mode is the first of these that names one of those words (or "auto",
# which stops the search at the board's default):
#
#   /run/ubuntu-gts9u/suspend-mode   this boot only.  Any restart, including
#                                    the forced one after a suspend that did
#                                    not come back, falls back to the rest.
#   /etc/ubuntu-gts9u/suspend-mode   until it is changed or removed.
#   the board's default              off on samsung,gts9wifi, whose deep
#                                    suspend does not resume yet; deep on every
#                                    other board, which changes nothing there.
#
# Each file holds a single word; '#' starts a comment.  After writing one,
# apply it with
#
#   systemctl restart ubuntu-gts9u-suspend-mode.service
#
# logind and systemd-sleep follow at once.  GNOME's idle default follows from
# the next login: dconf reads its profile when a program starts.
#
# `ubuntu-gts9u-suspend-mode status` shows what is in effect.
#
# Two things are outside this switch.  Whatever writes /sys/power/state itself
# never asks logind: the boot-time panel recovery, which runs whatever the
# mode, but also "rtcwake -m mem" or a hand-typed echo.  A masked sleep.target or
# suspend.target overrides every mode, so nothing suspends until it is
# unmasked; both commands below say so when they find one.
set -eu

runtime_choice=/run/ubuntu-gts9u/suspend-mode
saved_choice=/etc/ubuntu-gts9u/suspend-mode
applied=/run/ubuntu-gts9u/suspend-mode.applied

dropin=50-ubuntu-gts9u-suspend-mode.conf
sleep_dropin=/run/systemd/sleep.conf.d/$dropin
logind_dropin=/run/systemd/logind.conf.d/$dropin

# /usr/share/dconf/profile/user is a link to $dconf_profile.  While that file
# does not exist dconf finds no profile at all and behaves exactly as it does
# without this package: the user's own settings over the schema defaults.
dconf_dir=/run/ubuntu-gts9u/dconf
dconf_profile=$dconf_dir/profile-user
dconf_db=$dconf_dir/suspend-off
dconf_keyfiles=/usr/share/ubuntu-gts9u/dconf/suspend-off.d

log() {
	echo "ubuntu-gts9u-suspend-mode: $*"
}

die() {
	log "$*" >&2
	exit 1
}

board_default() {
	if [ -r /proc/device-tree/compatible ] &&
		tr '\0' '\n' < /proc/device-tree/compatible | grep -qx 'samsung,gts9wifi'; then
		echo off
	else
		echo deep
	fi
}

# First word of the first line that is not blank once comments are removed.
read_choice() {
	[ -r "$1" ] || return 0
	sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]].*//' -e '/^$/d' "$1" |
		head -n 1 | tr '[:upper:]' '[:lower:]'
}

# Sets $mode and $source.
resolve_mode() {
	for file in "$runtime_choice" "$saved_choice"; do
		choice=$(read_choice "$file")
		[ -n "$choice" ] || continue
		case "$choice" in
		off|s2idle|deep)
			mode=$choice
			source=$file
			return 0
			;;
		auto)
			mode=$(board_default)
			source="the board default, as $file asks"
			return 0
			;;
		*)
			log "ignoring '$choice' in $file: expected off, s2idle, deep or auto" >&2
			;;
		esac
	done
	mode=$(board_default)
	source="the board default"
}

# Atomically make $1 hold $2 and a final newline.  Status 0 if that changed
# the file, 1 if it already held exactly this.  Anything that cannot be
# written stops the script: a half-applied mode must show up as a failed unit.
replace() {
	target=$1
	mkdir -p "${target%/*}" || die "cannot create ${target%/*}"
	tmp=$(mktemp "$target.XXXXXX") || die "cannot write next to $target"
	if ! printf '%s\n' "$2" > "$tmp" || ! chmod 0644 "$tmp"; then
		rm -f "$tmp"
		die "cannot write $target"
	fi
	if cmp -s "$tmp" "$target"; then
		rm -f "$tmp"
		return 1
	fi
	mv -f "$tmp" "$target" || { rm -f "$tmp"; die "cannot replace $target"; }
}

# Status 0 if there was something to remove.
discard() {
	[ -e "$1" ] || [ -L "$1" ] || return 1
	rm -f "$1" || die "cannot remove $1"
}

masked_targets() {
	for unit in sleep.target suspend.target; do
		for dir in /etc/systemd/system /run/systemd/system; do
			if [ "$(readlink "$dir/$unit" 2>/dev/null)" = /dev/null ]; then
				printf '%s ' "$unit"
				break
			fi
		done
	done
}

# Only the mode, not where it came from: the same mode chosen in another place
# must leave the files, and therefore logind, untouched.
header() {
	echo "# Written by ubuntu-gts9u-suspend-mode for mode '$mode'.  It is rewritten"
	echo "# on every boot: choose the mode in $saved_choice"
	echo "# (or $runtime_choice for this boot only) instead of editing this."
}

sleep_config() {
	header
	echo '[Sleep]'
	case "$mode" in
	off)
		# Also rules out suspend-then-hibernate and hybrid sleep, which
		# both suspend first (sleep.conf.d(5)).
		echo 'AllowSuspend=no'
		;;
	s2idle)
		echo 'SuspendState=freeze'
		;;
	esac
}

logind_config() {
	header
	# Lock rather than suspend.  The suspend would be refused anyway, but
	# logind would then do nothing at all and leave an unlocked desktop under
	# the cover.  ExternalPower is spelled out because logind only falls back
	# to HandleLidSwitch while it is unset, so a drop-in that sets it would
	# otherwise still ask for a suspend whenever a charger is connected.
	echo '[Login]'
	echo 'HandleLidSwitch=lock'
	echo 'HandleLidSwitchExternalPower=lock'
}

apply_sleep() {
	if [ "$mode" = deep ]; then
		discard "$sleep_dropin" || true
	else
		replace "$sleep_dropin" "$(sleep_config)" || true
	fi
}

# Status 0 when logind's configuration changed.
apply_logind() {
	if [ "$mode" = off ]; then
		replace "$logind_dropin" "$(logind_config)"
	else
		discard "$logind_dropin"
	fi
}

apply_gnome() {
	if [ "$mode" != off ]; then
		discard "$dconf_profile" || true
		discard "$dconf_db" || true
		return 0
	fi
	if ! command -v dconf >/dev/null 2>&1; then
		log "dconf is missing: GNOME keeps its own idle default, and logind refuses the suspend it asks for" >&2
		discard "$dconf_profile" || true
		return 0
	fi
	mkdir -p "$dconf_dir" || die "cannot create $dconf_dir"
	tmp=$(mktemp "$dconf_db.XXXXXX") || die "cannot write next to $dconf_db"
	if ! dconf compile "$tmp" "$dconf_keyfiles"; then
		rm -f "$tmp"
		log "could not compile $dconf_keyfiles: GNOME keeps its own idle default" >&2
		discard "$dconf_profile" || true
		return 0
	fi
	chmod 0644 "$tmp" || die "cannot write $dconf_db"
	mv -f "$tmp" "$dconf_db" || { rm -f "$tmp"; die "cannot replace $dconf_db"; }
	# The user's own database comes first, so whatever the owner chose in
	# Settings or with gsettings still wins; this only supplies the defaults.
	replace "$dconf_profile" "# Written by ubuntu-gts9u-suspend-mode for mode 'off'.
user-db:user
file-db:$dconf_db" || true
}

warn_overrides() {
	masked=$(masked_targets)
	if [ -n "$masked" ]; then
		if [ "$mode" = off ]; then
			log "note: ${masked}masked; harmless with mode off, but it must be undone before s2idle or deep can work: systemctl unmask ${masked% }"
		else
			log "warning: ${masked}masked: mode $mode cannot suspend until 'systemctl unmask ${masked% }'" >&2
		fi
	fi
	case "$mode" in
	s2idle)
		grep -qw freeze /sys/power/state 2>/dev/null ||
			log "warning: this kernel offers no suspend-to-idle (/sys/power/state: $(cat /sys/power/state 2>/dev/null))" >&2
		;;
	deep)
		if grep -q '\[s2idle\]' /sys/power/mem_sleep 2>/dev/null; then
			log "warning: /sys/power/mem_sleep defaults to s2idle on this kernel, so mode deep suspends to idle" >&2
		fi
		;;
	esac
}

apply() {
	resolve_mode
	# The sleep drop-in first: it is the one that actually stops a suspend.
	apply_sleep
	logind_changed=no
	if apply_logind; then
		logind_changed=yes
	fi
	apply_gnome
	replace "$applied" "$mode" || true
	log "mode $mode, from $source"
	warn_overrides

	# At boot this runs before logind, which reads the new drop-in when it
	# starts.  Later, logind rereads its configuration on SIGHUP (systemd 254
	# and newer), which is what reload sends.  That is not a restart, which
	# would disturb the running sessions.  --no-block because this unit is
	# ordered before logind: a waiting reload would wait for this very job.
	if [ "$logind_changed" = yes ] &&
		systemctl is-active --quiet systemd-logind.service 2>/dev/null; then
		systemctl --no-block reload systemd-logind.service ||
			log "could not ask logind to reload; the cover setting applies from the next boot" >&2
	fi
}

status() {
	resolve_mode
	echo "configured mode: $mode ($source)"
	if [ -r "$applied" ]; then
		echo "applied mode:    $(cat "$applied")"
		[ "$(cat "$applied")" = "$mode" ] ||
			echo "                 run 'systemctl restart ubuntu-gts9u-suspend-mode.service' to apply"
	else
		echo "applied mode:    none, ubuntu-gts9u-suspend-mode.service has not run"
	fi
	if [ -r /proc/device-tree/compatible ]; then
		echo "board:           $(tr '\0' ' ' < /proc/device-tree/compatible)"
	fi
	echo "kernel:          state [$(cat /sys/power/state 2>/dev/null)], mem_sleep [$(cat /sys/power/mem_sleep 2>/dev/null)]"
	masked=$(masked_targets)
	[ -z "$masked" ] || echo "masked:          ${masked}(overrides every mode)"
	for file in "$sleep_dropin" "$logind_dropin" "$dconf_profile"; do
		[ -e "$file" ] || continue
		echo "--- $file"
		grep -v '^#' "$file" || true
	done
	if command -v busctl >/dev/null 2>&1; then
		echo "logind CanSuspend: $(busctl call org.freedesktop.login1 \
			/org/freedesktop/login1 org.freedesktop.login1.Manager CanSuspend 2>&1)"
		for property in HandleLidSwitch HandleLidSwitchExternalPower; do
			echo "logind $property: $(busctl get-property org.freedesktop.login1 \
				/org/freedesktop/login1 org.freedesktop.login1.Manager "$property" 2>&1)"
		done
	fi
}

case "${1:-apply}" in
apply) apply ;;
status) status ;;
*)
	echo "usage: ${0##*/} [apply|status]" >&2
	exit 2
	;;
esac
