+        /// Filters the source for the current camera and mode. A change
+        /// restarts the stream, so it waits for a capture to finish.
+        pub(crate) fn update_source_caps(&self) {
+            if self.is_taking_picture.get() || self.is_recording_video.borrow().is_some() {
+                return;
+            }
+            let (Some(camera), Some(capsfilter)) =
+                (self.camera.borrow().clone(), self.capsfilter.borrow().clone())
+            else {
+                return;
+            };
+
+            let caps = camera.source_caps(self.picture_mode.get());
+            if capsfilter.property::<gst::Caps>("caps") != caps {
+                capsfilter.set_property("caps", &caps);
+            }
+        }
     }
 
