+    /// Sets whether the viewfinder streams for pictures.
+    ///
+    /// Pictures are taken from the viewfinder's stream. In picture mode it
+    /// streams at the camera's largest resolution, so that pictures are taken
+    /// at full resolution without restarting the camera. Otherwise it streams
+    /// at the size used for recording, at most 1080p.
+    ///
+    /// Changing the mode restarts the stream once; during a capture, the
+    /// change waits for the capture to finish.
+    pub fn set_picture_mode(&self, picture_mode: bool) {
+        let imp = self.imp();
+        if imp.picture_mode.replace(picture_mode) != picture_mode {
+            imp.update_source_caps();
+        }
+    }
