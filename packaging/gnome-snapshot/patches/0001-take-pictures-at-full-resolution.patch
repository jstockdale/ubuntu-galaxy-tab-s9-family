+    pub(crate) fn best_resolution_for_stills(caps: &gst::Caps) -> gst::Caps {
+        let raw = caps.intersect_with_mode(
+            &gst::Caps::builder("video/x-raw").build(),
+            gst::CapsIntersectMode::First,
