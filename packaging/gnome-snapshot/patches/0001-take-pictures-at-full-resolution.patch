+    fn test_stills_resolution() {
+        gst::init().expect("Failed to initalize gst");
+
+        // A 4128x3096 sensor through libcamera's software ISP.
+        let caps = caps::limit_fps(&raw_sizes(&[
+            (640, 480),
+            (1280, 1080),
+            (1920, 1080),
+            (1600, 1200),
+            (3840, 1080),
+            (4120, 3096),
+        ]));
+
+        assert_eq!(caps::largest_size(&caps), Some((4120, 3096)));
+        let stills = caps::best_resolution_for_stills(&caps);
+        assert_eq!(stills.size(), 1);
+        assert_eq!(first_size(&stills), (4120, 3096));
+
+        // Video keeps the largest height up to 1080p.
+        let fps = gst::Fraction::new(crate::MAXIMUM_RATE, 1);
+        assert_eq!(first_size(&caps::best_resolution_for_fps(&caps, fps)), (1280, 1080));
+
+        // No raw format: no full-resolution stream.
+        let jpeg = gst::Caps::builder("image/jpeg")
+            .field("width", 1920)
+            .field("height", 1080)
+            .build();
+        assert!(caps::best_resolution_for_stills(&jpeg).is_empty());
+    }
