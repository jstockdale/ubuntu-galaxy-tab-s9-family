+fn source_caps(device: &gst::Device, picture_mode: bool) -> gst::Caps {
+    let caps = caps(device);
+    log::debug!("Found caps: {caps}");
+    let mut source_caps = if picture_mode {
+        utils::caps::best_resolution_for_stills(&caps)
+    } else {
+        gst::Caps::new_empty()
+    };
+    source_caps.merge(filter_caps(&caps));
+    log::debug!("Using caps: {source_caps}");
+    source_caps
+}
+
+/// pipewiresrc 1.0 restarts the camera for every RECONFIGURE event, and
+/// camerabin sends several for each picture without changing the format.
+/// Drop those whose preferred caps match the caps in use, as pipewiresrc
+/// itself does from PipeWire 1.1.81 (commit e2e8cf79).
+fn drop_redundant_reconfigure(pad: &gst::Pad, info: &mut gst::PadProbeInfo) -> gst::PadProbeReturn {
+    use gst::prelude::*;
+
+    if !info
+        .event()
+        .is_some_and(|event| event.type_() == gst::EventType::Reconfigure)
+    {
+        return gst::PadProbeReturn::Ok;
+    }
+    let Some(current) = pad.current_caps() else {
+        return gst::PadProbeReturn::Ok;
+    };
+
+    // What the source would negotiate: its caps, filtered downstream.
+    let source = pad.peer().map(|peer| peer.query_caps(None));
+    let caps = pad.query_caps(source.as_ref());
+    match caps.structure(0) {
+        Some(preferred) if gst::Caps::from(preferred.to_owned()).can_intersect(&current) => {
+            log::debug!("Skipping a reconfiguration that keeps {current}");
+            gst::PadProbeReturn::Drop
         }
+        _ => gst::PadProbeReturn::Ok,
     }
 }
 
