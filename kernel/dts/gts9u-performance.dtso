/dts-v1/;
/plugin/;

/*
 * Ultra-only additions, applied by Linux before DRM probes, never by Samsung
 * ABL.  The prime-CPU boost OPP that every family board needs lives in
 * gts9-performance.dtso.  719 MHz is the top of Samsung's GPU bin 0, which
 * kgsl selects by SoC feature code (AC, AF and internal parts); it stays here
 * until another board's unit is confirmed to be that bin.
 */
/ {
	fragment@0 {
		target-path = "/soc@0/gpu@3d00000/opp-table";
		__overlay__ {
			opp-719000000 {
				opp-hz = /bits/ 64 <719000000>;
				/* RPMH_REGULATOR_LEVEL_SVS_L2, Samsung X910 bin 0. */
				opp-level = <224>;
				opp-peak-kBps = <16500000>;
				qcom,opp-acd-level = <0x882e5ffd>;
			};
		};
	};
};
