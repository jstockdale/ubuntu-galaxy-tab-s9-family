+static void qcom_stats_vx_init(struct device *dev, struct dentry *root, void __iomem *reg,
+			       const struct stats_config *config)
+{
+	if (!qcom_stats_qmp || !of_machine_is_compatible("qcom,sm8550"))
+		return;
+
+	qcom_stats_vx_base = devm_ioremap(dev, QCOM_STATS_VX_BASE_SM8550, QCOM_STATS_VX_SIZE);
+	if (!qcom_stats_vx_base)
+		return;
+	if (register_pm_notifier(&qcom_stats_vx_nb)) {
+		qcom_stats_vx_base = NULL;
+		return;
+	}
+	debugfs_create_file("cxpc_violators", 0400, root, NULL, &qcom_stats_vx_fops);
+	debugfs_create_file("cxpc_violators_raw", 0400, root, NULL, &qcom_stats_vx_raw_fops);
+
+	/*
+	 * The votes follow the DDR stats' entries in the stats region (0x400
+	 * bytes): there is room for them at the largest entry count.
+	 */
+	BUILD_BUG_ON(0xb8 + DDR_STATS_ENTRY_START_ADDR +
+		     DDR_STATS_MAX_NUM_MODES * sizeof(struct ddr_stats_entry) +
+		     4 * QCOM_STATS_DDR_VOTE_DRVS > 0x400);
+	if (config->ddr_stats_offset == 0xb8 &&
+	    readl_relaxed(reg + config->ddr_stats_offset + DDR_STATS_MAGIC_KEY_ADDR) == DDR_STATS_MAGIC_KEY) {
+		qcom_stats_ddr_base = reg + config->ddr_stats_offset;
+		debugfs_create_file("ddr_votes", 0400, root, NULL, &qcom_stats_ddr_votes_fops);
+	}
+}
