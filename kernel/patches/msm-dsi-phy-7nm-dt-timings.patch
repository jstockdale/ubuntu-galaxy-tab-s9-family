 #include "dsi_phy.h"
 #include "dsi.xml.h"
@@ -29,6 +31,36 @@
 		 "override the 14 D-PHY TIMING_CTRL registers (bring-up experiments)");
 
 /*
+ * The same table as board data: qcom,dsi-phy-timings holds the 14 bytes the
+ * vendor tuned for the lane rate in qcom,dsi-phy-timings-bitclk-hz (the
+ * Samsung panels' qcom,mdss-dsi-panel-phy-timings and -clockrate).  It is used
+ * only while the requested rate is within 1% of that one; any other rate gets
+ * the computed timings.
+ */
+static bool dsi_7nm_phy_dt_timings(struct msm_dsi_phy *phy,
+				   unsigned long bitclk_rate, u8 *table)
+{
+	struct device_node *np = phy->pdev->dev.of_node;
+	u32 rate;
+
+	if (of_property_count_u8_elems(np, "qcom,dsi-phy-timings") !=
+	    ARRAY_SIZE(dsi_phy_timings) ||
+	    of_property_read_u32(np, "qcom,dsi-phy-timings-bitclk-hz", &rate) ||
+	    !rate)
+		return false;
+
+	if (abs_diff(bitclk_rate, (unsigned long)rate) > rate / 100) {
+		dev_info_once(&phy->pdev->dev,
+			      "D-PHY timing table is for %u bps, computing timings for %lu bps\n",
+			      rate, bitclk_rate);
+		return false;
+	}
+
+	return !of_property_read_u8_array(np, "qcom,dsi-phy-timings", table,
+					  ARRAY_SIZE(dsi_phy_timings));
+}
+
+/*
  * DSI PLL 7nm - clock diagram (eg: DSI0): TODO: updated CPHY diagram
  *
