@@ -1189,16 +1221,37 @@
 		writel(timing->shared_timings.clk_post,
 		       base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_13);
 	}
-	if (!phy->cphy_mode &&
-	    dsi_phy_timings_count == ARRAY_SIZE(dsi_phy_timings)) {
+	if (!phy->cphy_mode) {
+		u8 dt_timings[ARRAY_SIZE(dsi_phy_timings)];
+		const u8 *table = NULL;
 		int i;
 
-		for (i = 0; i < ARRAY_SIZE(dsi_phy_timings); i++)
-			writel(dsi_phy_timings[i],
-			       base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_0 + 4 * i);
-		DRM_DEV_INFO(&phy->pdev->dev,
-			     "D-PHY timings overridden from the command line: %14ph\n",
-			     dsi_phy_timings);
+		if (dsi_phy_timings_count == ARRAY_SIZE(dsi_phy_timings)) {
+			table = dsi_phy_timings;
+			DRM_DEV_INFO(&phy->pdev->dev,
+				     "D-PHY timings overridden from the command line: %14ph\n",
+				     dsi_phy_timings);
+		} else if (dsi_7nm_phy_dt_timings(phy, clk_req->bitclk_rate,
+						  dt_timings)) {
+			table = dt_timings;
+			dev_info_once(&phy->pdev->dev,
+				      "D-PHY timings from the device tree: %14ph\n",
+				      dt_timings);
+		}
+
+		if (table) {
+			for (i = 0; i < ARRAY_SIZE(dsi_phy_timings); i++)
+				writel(table[i],
+				       base + REG_DSI_7nm_PHY_CMN_TIMING_CTRL_0 + 4 * i);
+			/*
+			 * The vendor driver programs the controller's
+			 * DSI_CLKOUT_TIMING_CTRL from the same clk_pre and
+			 * clk_post (qcom,mdss-dsi-t-clk-pre/post); the host
+			 * takes them from the shared timings.
+			 */
+			timing->shared_timings.clk_pre = table[12];
+			timing->shared_timings.clk_post = table[13];
+		}
 	}
 
