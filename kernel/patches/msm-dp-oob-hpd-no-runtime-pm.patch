Subject: drm/msm/dp: don't hold USB-C DP controllers resumed for HPD

drm_bridge_connector enables hotplug detection on the msm_dp bridge as
soon as output polling starts, and msm_dp_bridge_hpd_enable() takes a
runtime PM reference that only hpd_disable (system suspend) releases.  On
the Samsung SM-X710 and SM-X910 the DP controller is a child of the MDSS
and has no downstream HPD bridge: the PS5169 redriver and the SM5714 TCPC
register no DRM bridge, so the QMP aux bridge never resolves and
msm-dp-allow-unresolved-usbc-bridge.patch leaves msm_dp as the HPD bridge.
That reference kept ae90000.displayport-controller, the MDSS, mdss_gdsc,
the display clock controller and their MMCX vote powered for the whole
uptime with no DP sink, while the DPU, DSI and DSI PHY were suspended.

On these boards HPD is out of band: the usb-c-connector names the
controller in its "displayport" property, typec_displayport turns every DP
Status Update and Attention into drm_connector_oob_hotplug_event() on that
fwnode, and the plug handler that msm_dp_bridge_hpd_notify() runs holds a
reference for as long as a sink is plugged.  Nothing drives the
controller's HPD input: GPIO47, the SoC's only dp_hot pin, is never muxed
to that function; Samsung's DP node muxes only the AUX select/enable
GPIOs 180 and 183 and takes HPD from the alternate mode
(qcom,altmode-dev).  The HPD block therefore has nothing to watch.
Samsung's own driver powers the DP host only between the altmode
configure and disconnect callbacks (display-drivers dp_display.c
dp_display_usbpd_configure_cb() / dp_display_usbpd_disconnect_cb()).  It
does arm the HPD block inside that window; this change never arms it on
these boards, like the upstream USB-C platforms described below.

Detect that topology once at bridge init and make hpd_enable/hpd_disable
no-ops for it.  DRM_BRIDGE_OP_HPD stays set, so the connector remains
DRM_CONNECTOR_POLL_HPD and is not polled every ten seconds.  This is the
state upstream USB-C platforms run in, sm8550-qrd and sm8550-hdk among
them: there an aux-hpd bridge is the HPD bridge, msm_dp's hpd_enable is
never called and its HPD block stays off.  Boards whose controller is not
referenced by a "displayport" property are unchanged.

--- a/drivers/gpu/drm/msm/dp/dp_drm.h
+++ b/drivers/gpu/drm/msm/dp/dp_drm.h
@@ -22,6 +22,7 @@ struct msm_dp_bridge {
 	enum drm_connector_status deferred_hpd_status;
 	bool defer_hpd_until_resume;
 	bool deferred_hpd_pending;
+	bool hpd_out_of_band;
 };
 
 #define to_dp_bridge(x)     container_of((x), struct msm_dp_bridge, bridge)
--- a/drivers/gpu/drm/msm/dp/dp_drm.c
+++ b/drivers/gpu/drm/msm/dp/dp_drm.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/jiffies.h>
+#include <linux/of.h>
 #include <linux/property.h>
 #include <linux/string_choices.h>
 #include <linux/suspend.h>
@@ -292,6 +293,31 @@ static void msm_dp_bridge_unregister_pm_
 	cancel_delayed_work_sync(&msm_dp_bridge->deferred_hpd_work);
 }
 
+/*
+ * A USB-C connector names its DisplayPort controller in a "displayport"
+ * property.  typec_displayport then reports every HPD change from the DP
+ * alternate mode's Status Update and Attention messages through
+ * drm_connector_oob_hotplug_event() on that controller's fwnode, and no
+ * hardware drives the controller's own HPD input.
+ */
+static bool msm_dp_bridge_hpd_is_out_of_band(const struct device_node *dp_np)
+{
+	struct device_node *np, *target;
+	bool found;
+
+	for_each_node_with_property(np, "displayport") {
+		target = of_parse_phandle(np, "displayport", 0);
+		found = target == dp_np;
+		of_node_put(target);
+		if (found) {
+			of_node_put(np);
+			return true;
+		}
+	}
+
+	return false;
+}
+
 int msm_dp_bridge_init(struct msm_dp *msm_dp_display, struct drm_device *dev,
 		   struct drm_encoder *encoder, bool yuv_supported)
 {
@@ -357,6 +383,19 @@ int msm_dp_bridge_init(struct msm_dp *ms
 		bridge->hdmi_audio_dev = &msm_dp_display->pdev->dev;
 		bridge->hdmi_audio_max_i2s_playback_channels = 8;
 		bridge->hdmi_audio_dai_port = -1;
+
+		/*
+		 * Keep DRM_BRIDGE_OP_HPD with out-of-band HPD too: it marks the
+		 * connector as hotplug-capable, so DRM does not poll detect()
+		 * every ten seconds.  hpd_enable() then leaves the controller
+		 * suspended, and msm_dp_bridge_hpd_notify() powers it while a
+		 * sink is plugged.
+		 */
+		msm_dp_bridge->hpd_out_of_band =
+			msm_dp_bridge_hpd_is_out_of_band(msm_dp_display->pdev->dev.of_node);
+		if (msm_dp_bridge->hpd_out_of_band)
+			dev_info(&msm_dp_display->pdev->dev,
+				 "USB-C out-of-band HPD: not holding the controller powered for HPD\n");
 	}
 
 	rc = devm_drm_bridge_add(dev->dev, bridge);
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1491,7 +1491,16 @@ void msm_dp_bridge_hpd_enable(struct drm
 	 * step-3: waiting for plugin irq while phy is not initialized
 	 * step-4: DP PHY is initialized at plugin handler before link training
 	 *
+	 * With out-of-band HPD (USB-C) there is no HPD input to watch:
+	 * plugs arrive through msm_dp_bridge_hpd_notify(), which powers the
+	 * controller for as long as a sink is plugged.  Holding a runtime PM
+	 * reference here instead would keep the controller, and with it the
+	 * MDSS, its GDSC and the display clock controller, powered for the
+	 * whole uptime with nothing attached.
 	 */
+	if (msm_dp_bridge->hpd_out_of_band)
+		return;
+
 	if (pm_runtime_resume_and_get(&msm_dp_display->pdev->dev)) {
 		DRM_ERROR("failed to resume power\n");
 		return;
@@ -1507,6 +1516,10 @@ void msm_dp_bridge_hpd_disable(struct dr
 	struct msm_dp *msm_dp_display = msm_dp_bridge->msm_dp_display;
 	struct msm_dp_display_private *dp = container_of(msm_dp_display, struct msm_dp_display_private, msm_dp_display);
 
+	/* msm_dp_bridge_hpd_enable() took no reference for out-of-band HPD. */
+	if (msm_dp_bridge->hpd_out_of_band)
+		return;
+
 	msm_dp_aux_hpd_intr_disable(dp->aux);
 	msm_dp_aux_hpd_disable(dp->aux);
 
