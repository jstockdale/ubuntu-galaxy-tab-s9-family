+void msm_dsi_regdump_block(struct device *dev, const char *block,
+			   const char *when, void __iomem *base, size_t size)
+{
+	size_t off;
+
+	for (off = 0; off + 16 <= size; off += 16)
+		dev_info(dev, "regdump %s %s +%03zx: %08x %08x %08x %08x\n",
+			 when, block, off, readl_relaxed(base + off),
+			 readl_relaxed(base + off + 4),
+			 readl_relaxed(base + off + 8),
+			 readl_relaxed(base + off + 12));
+}
+
+/* The whole controller window, including the 6G register shift. */
+void msm_dsi_host_regdump(struct mipi_dsi_host *host, const char *when)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 shift = msm_host->cfg_hnd->cfg->io_offset;
+
+	msm_dsi_regdump_block(&msm_host->pdev->dev, "ctrl", when,
+			      msm_host->ctrl_base - shift,
+			      msm_host->ctrl_size + shift);
+}
