 EXPORT_SYMBOL_GPL(typec_partner_altmode_dev_type);
 
+static int typec_partner_reprobe_altmode(struct device *dev, void *data)
+{
+	int ret;
+
+	if (dev->type != &typec_partner_altmode_dev_type || dev->driver)
+		return 0;
+
+	ret = device_attach(dev);
+	if (ret < 0)
+		dev_warn(dev, "alternate mode re-probe failed: %d\n", ret);
+	return 0;
+}
+
+/*
+ * Re-probe driverless partner alternate modes.  Driver eligibility can
+ * depend on the port's data role: typec_displayport refuses to bind while
+ * the port is UFP, so a mode discovered before a data role swap completes
+ * would otherwise stay driverless until the next physical re-plug.
+ */
+static void typec_partner_altmode_reprobe_work(struct work_struct *work)
+{
+	struct typec_partner *partner = container_of(work, struct typec_partner,
+						     altmode_reprobe_work);
+
+	device_for_each_child(&partner->dev, NULL,
+			      typec_partner_reprobe_altmode);
+	put_device(&partner->dev);
+}
